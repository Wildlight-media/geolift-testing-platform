# Copy to .env and fill in for real deployments. Docker Compose reads this
# automatically for variable interpolation.

JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
# Baked into the frontend at build time (Next.js NEXT_PUBLIC_* vars aren't
# overridable at container runtime) - the browser calls this URL directly,
# so it must be reachable from wherever your users' browsers are, not just
# from inside the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public hostnames served by Caddy (HTTPS is automatic). SITE_DOMAIN serves the static
# homepage in ./site (plus www redirect). Point DNS A records for all of them
# at the server, then set:
#   FRONTEND_URL=https://$APP_DOMAIN
#   NEXT_PUBLIC_API_URL=https://$API_DOMAIN
SITE_DOMAIN=example.com
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
